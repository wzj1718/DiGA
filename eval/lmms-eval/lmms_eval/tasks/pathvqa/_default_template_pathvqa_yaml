dataset_path: !env [DIFA_DATA_ROOT, ./data, "MLLM/path-vqa"]
dataset_kwargs:
  cache_dir: !env [HF_DATASETS_CACHE, ./.hf_datasets_cache]
  local_files_only: true
output_type: generate_until
